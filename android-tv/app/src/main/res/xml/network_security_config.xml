<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <!-- Narrow household exception. Rename the server to sketchbook.local or
         use HTTPS for every other hostname and private IP. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain>sketchbook.local</domain>
    </domain-config>
</network-security-config>
